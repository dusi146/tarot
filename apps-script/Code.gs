    { id: "01", name: "The Magician", viName: "Phù Thủy", file: "01-TheMagician.png", element: "Gió", meaning: "Ý chí hiện thực hóa, làm chủ nguồn lực, năng lực kiến tạo", revMeaning: "Thao túng, ảo tưởng sức mạnh, tiềm năng chưa được khai mở" },
    { id: "02", name: "The High Priestess", viName: "Nữ Tư Tế", file: "02-TheHighPriestess.png", element: "Nước", meaning: "Trực giác linh cảm, bí mật nội tâm, sự tĩnh lặng lắng nghe", revMeaning: "Bỏ qua tiếng nói nội tâm, bộc phát cảm xúc, bí mật bị phơi bày" },
    { id: "03", name: "The Empress", viName: "Hoàng Hậu", file: "03-TheEmpress.png", element: "Đất", meaning: "Sự trù phú, nuôi dưỡng, tình yêu thương và sinh sôi", revMeaning: "Bế tắc sáng tạo, ngột ngạt kiểm soát, thiếu thốn chăm sóc bản thân" },
    { id: "04", name: "The Emperor", viName: "Hoàng Đế", file: "04-TheEmperor.png", element: "Lửa", meaning: "Trật tự, nguyên tắc, sự vững chãi và năng lực kiểm soát", revMeaning: "Độc đoán, bảo thủ cứng nhắc, lạm quyền hoặc bất lực buông xuôi" },
    { id: "05", name: "The Hierophant", viName: "Giáo Hoàng", file: "05-TheHierophant.png", element: "Đất", meaning: "Truyền thống, khuôn mẫu đạo đức, tìm kiếm sự chỉ dẫn", revMeaning: "Phá vỡ quy chuẩn cũ, tư duy độc lập hoặc bảo thủ mù quáng" },
    { id: "06", name: "The Lovers", viName: "Đôi Tình Nhân", file: "06-TheLovers.png", element: "Khí", meaning: "Sự hòa hợp, cam kết sâu sắc, ngã rẽ lựa chọn của trái tim", revMeaning: "Bất hòa rạn nứt, xung đột giá trị sống, trốn tránh trách nhiệm" },
    { id: "07", name: "The Chariot", viName: "Cỗ Xe Chiến", file: "07-TheChariot.png", element: "Nước", meaning: "Ý chí kiên định, vượt qua xung đột, tự chủ tiến bước", revMeaning: "Mất phương hướng, hung hăng hiếu thắng, mất kiểm soát tay lái" },
    { id: "08", name: "Strength", viName: "Sức Mạnh", file: "08-Strength.png", element: "Lửa", meaning: "Sức mạnh nội tâm, lòng trắc ẩn thuần hóa đam mê hoang dã", revMeaning: "Tự ti, yếu lòng trước cám dỗ, hoài nghi năng lực chính mình" },
    { id: "09", name: "The Hermit", viName: "Ẩn Sĩ", file: "09-TheHermit.png", element: "Đất", meaning: "Tĩnh lặng suy ngẫm, tách biệt để thấu suốt, ngọn đèn dẫn đường", revMeaning: "Cô lập cực đoan, trốn tránh thế gian, lạc lối trong bóng tối" },
    { id: "10", name: "Wheel of Fortune", viName: "Bánh Xe Số Phận", file: "10-WheelOfFortune.png", element: "Lửa", meaning: "Chu kỳ thay đổi, thời vận xoay chuyển, buông bỏ để thuận dòng", revMeaning: "Trở ngại thời vận tạm thời, kháng cự thay đổi, xui xẻo nhất thời" },
    { id: "11", name: "Justice", viName: "Công Lý", file: "11-Justice.png", element: "Khí", meaning: "Sự thật tỏ tường, trách nhiệm cá nhân, quả báo công bằng", revMeaning: "Bất công, định kiến sai lệch, trốn tránh nhận lỗi lầm" },
    { id: "12", name: "The Hanged Man", viName: "Người Treo Ngược", file: "12-TheHangedMan.png", element: "Nước", meaning: "Đổi thay góc nhìn, chấp nhận trì hoãn, hy sinh vì điều lớn hơn", revMeaning: "Trì hoãn vô nghĩa, hy sinh mù quáng, cố chấp không chịu thức tỉnh" },
    { id: "13", name: "Death", viName: "Chuyển Hóa", file: "13-Death.png", element: "Nước", meaning: "Kết thúc chu kỳ cũ, buông bỏ quá khứ, lột xác để tái sinh", revMeaning: "Bám víu chấp niệm quá khứ, sợ hãi cái mới, trì hoãn đổi thay" },
    { id: "14", name: "Temperance", viName: "Tiết Độ", file: "14-Temperance.png", element: "Lửa", meaning: "Cân bằng, dung hòa các mặt đối lập, kiên nhẫn chữa lành", revMeaning: "Mất cân đối, cực đoan quá độ, mất kiên nhẫn trong các mối quan hệ" },
    { id: "15", name: "The Devil", viName: "Ràng Buộc", file: "15-TheDevil.png", element: "Đất", meaning: "Vướng mắc cám dỗ, nỗi sợ thao túng, tự giam mình trong ảo tưởng", revMeaning: "Thức tỉnh thoát khỏi xiềng xích, nhìn thấu cám dỗ, tìm lại tự do" },
    { id: "16", name: "The Tower", viName: "Tháp Đổ", file: "16-TheTower.png", element: "Lửa", meaning: "Vỡ lẽ sự thật, biến cố sụp đổ ảo tưởng, giải phóng giải thoát", revMeaning: "Tránh né khủng hoảng tạm thời, nỗi đau âm ỉ kéo dài" },
    { id: "17", name: "The Star", viName: "Ngôi Sao", file: "17-TheStar.png", element: "Khí", meaning: "Hy vọng tái sinh, bình yên thanh thản, nguồn cảm hứng từ vũ trụ", revMeaning: "Mất niềm tin, bi quan thất vọng, cảm giác bơ vơ lạc lối" },
    { id: "18", name: "The Moon", viName: "Mặt Trăng", file: "18-TheMoon.png", element: "Nước", meaning: "Hồ nghi bất an, sương mù tiềm thức, trực giác xuyên qua ảo ảnh", revMeaning: "Sương mù tan biến, sự thật hé lộ, giải tỏa nỗi lo âu thầm kín" },
    { id: "19", name: "The Sun", viName: "Mặt Trời", file: "19-TheSun.png", element: "Lửa", meaning: "Rực rỡ, niềm vui thuần khiết, thành tựu sáng tỏ và tự tin", revMeaning: "Niềm vui bị che khuất tạm thời, tự phụ kiêu ngạo, bi quan không đáng" },
    { id: "20", name: "Judgement", viName: "Phán Xét", file: "20-Judgement.png", element: "Lửa", meaning: "Tiếng gọi thức tỉnh, tha thứ cho chính mình, tái sinh tinh thần", revMeaning: "Tự phán xét khắt khe, do dự không dám quyết định, chối bỏ tiếng gọi" },
    { id: "21", name: "The World", viName: "Thế Giới", file: "21-TheWorld.png", element: "Đất", meaning: "Trọn vẹn viên mãn, hoàn tất bài học, bước vào tầm cao mới", revMeaning: "Thiếu mảnh ghép cuối, việc dở dang chưa hoàn tất, trì trệ về đích" },

    // 14 Lá Bộ Cốc (Cups - Nước - Cảm xúc & Tâm hồn)
    { id: "C01", name: "Ace of Cups", viName: "Át Cốc", file: "Cups01.png", element: "Nước", meaning: "Nguồn cảm xúc dạt dào, tình cảm mới nảy nở, con tim rộng mở", revMeaning: "Cảm xúc bị kìm nén, tổn thương con tim, cạn kiệt tình cảm" },
    { id: "C02", name: "Two of Cups", viName: "Hai Cốc", file: "Cups02.png", element: "Nước", meaning: "Sự kết nối tri kỷ, gắn kết hai tâm hồn, hòa hợp tương giao", revMeaning: "Hiểu lầm chia cách, cái tôi đối đầu, rạn nứt kết nối" },
    { id: "C03", name: "Three of Cups", viName: "Ba Cốc", file: "Cups03.png", element: "Nước", meaning: "Ăn mừng sum vầy, sẻ chia niềm vui giữa những người bạn", revMeaning: "Thị phi hội nhóm, tiệc tùng quá đà, bất đồng bè bạn" },
    { id: "C04", name: "Four of Cups", viName: "Bốn Cốc", file: "Cups04.png", element: "Nước", meaning: "Trầm tư mặc tưởng, thờ ơ chán nản, bỏ lỡ cơ hội trước mắt", revMeaning: "Thức tỉnh nhận ra cơ hội, lấy lại cảm hứng và sự hào hứng" },
    { id: "C05", name: "Five of Cups", viName: "Năm Cốc", file: "Cups05.png", element: "Nước", meaning: "Nuối tiếc mất mát, đau buồn dĩ vãng, nhìn về những chiếc cốc đổ", revMeaning: "Chấp nhận chữa lành, hướng về những gì còn lại, đứng dậy bước tiếp" },
    { id: "C06", name: "Six of Cups", viName: "Sáu Cốc", file: "Cups06.png", element: "Nước", meaning: "Ký ức ngọt ngào, hoài niệm trong sáng, gặp lại người quen cũ", revMeaning: "Mắc kẹt trong quá khứ, từ chối trưởng thành, ảo tưởng ngày xưa" },
    { id: "C07", name: "Seven of Cups", viName: "Bảy Cốc", file: "Cups07.png", element: "Nước", meaning: "Nhiều ảo tưởng cám dỗ, đứng trước nhiều ngã rẽ mộng tưởng", revMeaning: "Tỉnh mộng, gạt bỏ mơ hồ, đưa ra lựa chọn thực tế sáng suốt" },
    { id: "C08", name: "Eight of Cups", viName: "Tám Cốc", file: "Cups08.png", element: "Nước", meaning: "Dũng cảm rời đi, buông bỏ điều không còn phù hợp để tìm chân trời mới", revMeaning: "Lưỡng lự níu kéo, sợ hãi bước vào vùng vô định, chấp nhận chịu đựng" },
    { id: "C09", name: "Nine of Cups", viName: "Chín Cốc", file: "Cups09.png", element: "Nước", meaning: "Ước nguyện thành hiện thực, mãn nguyện tràn đầy, niềm vui cá nhân", revMeaning: "Hài lòng hời hợt, tự mãn vật chất, chưa thực sự trọn vẹn bên trong" },
    { id: "C10", name: "Ten of Cups", viName: "Mười Cốc", file: "Cups10.png", element: "Nước", meaning: "Bình yên mái ấm, hạnh phúc gia đình trọn vẹn, cầu vồng phước lành", revMeaning: "Rạn nứt tổ ấm, bất hòa nội bộ gia đình, khoảng cách thế hệ" },
    { id: "C11", name: "Page of Cups", viName: "Bồi Cốc", file: "Cups11.png", element: "Nước", meaning: "Tin nhắn yêu thương, trực giác chớm nở, tâm hồn nhạy cảm nghệ thuật", revMeaning: "Cảm xúc bốc đồng thất thường, ngây thơ cả tin, thất vọng tình cảm" },
    { id: "C12", name: "Knight of Cups", viName: "Kỵ sĩ Cốc", file: "Cups12.png", element: "Nước", meaning: "Hiệp sĩ lãng mạn, theo đuổi tiếng gọi trái tim, lời mời hấp dẫn", revMeaning: "Ảo tưởng tình ái, hứa hẹn suông, dễ thay lòng đổi dạ" },
    { id: "C13", name: "Queen of Cups", viName: "Hậu Cốc", file: "Cups13.png", element: "Nước", meaning: "Người mẹ từ tâm, thấu cảm sâu sắc, làm chủ dòng chảy trực giác", revMeaning: "Đa sầu đa cảm, tâm lý phụ thuộc, cảm xúc lấn át lý trí" },
    { id: "C14", name: "King of Cups", viName: "Vua Cốc", file: "Cups14.png", element: "Nước", meaning: "Bậc thầy điềm tĩnh, làm chủ cảm xúc, chỗ dựa vững chãi đầy bao dung", revMeaning: "Thao túng tâm lý, lạnh nhạt che giấu, bùng nổ cảm xúc ngầm" },

    // 14 Lá Bộ Tiền (Pentacles - Đất - Tài chính & Hiện thực)
    { id: "P01", name: "Ace of Pentacles", viName: "Át Xu", file: "Pentacles01.png", element: "Đất", meaning: "Mầm mống tài chính thực tế, cơ hội vững chắc, khởi nghiệp phát đạt", revMeaning: "Bỏ lỡ cơ hội làm ăn, chi tiêu thiếu kiểm soát, kế hoạch thiếu tính khả thi" },
    { id: "P02", name: "Two of Pentacles", viName: "Hai Xu", file: "Pentacles02.png", element: "Đất", meaning: "Uyển chuyển xoay sở, thích nghi linh hoạt, cân bằng tài chính công việc", revMeaning: "Mất thăng bằng, ôm đồm quá tải, nợ nần bủa vây" },
    { id: "P03", name: "Three of Pentacles", viName: "Ba Xu", file: "Pentacles03.png", element: "Đất", meaning: "Hợp tác chuyên nghiệp, kiến tạo nền móng vững bền, tài năng được tôn vinh", revMeaning: "Bất đồng nhóm làm việc, thiếu chuyên nghiệp, kỹ năng còn non nớt" },
    { id: "P04", name: "Four of Pentacles", viName: "Bốn Xu", file: "Pentacles04.png", element: "Đất", meaning: "Giữ vững tài sản, tích lũy an toàn, phòng thủ cẩn trọng", revMeaning: "Keo kiệt bủn xỉn, sợ mất mát vật chất, bám víu kiểm soát quá mức" },
    { id: "P05", name: "Five of Pentacles", viName: "Năm Xu", file: "Pentacles05.png", element: "Đất", meaning: "Thử thách vật chất, cảm giác cô đơn giá lạnh, khó khăn tạm thời", revMeaning: "Ánh sáng cuối đường hầm, phục hồi kinh tế, tìm thấy sự giúp đỡ" },
    { id: "P06", name: "Six of Pentacles", viName: "Sáu Xu", file: "Pentacles06.png", element: "Đất", meaning: "Cho và nhận cân bằng, lòng hào phóng sẻ chia, nhận được trợ lực công bằng", revMeaning: "Mắc nợ bất bình đẳng, lòng tốt bị lợi dụng, ban ơn trịch thượng" },
    { id: "P07", name: "Seven of Pentacles", viName: "Bảy Xu", file: "Pentacles07.png", element: "Đất", meaning: "Kiên nhẫn chờ mùa quả chín, đánh giá thành quả, định hướng dài hạn", revMeaning: "Sốt ruột bỏ dở, đầu tư không hiệu quả, thất vọng vì kết quả chậm" },
    { id: "P08", name: "Eight of Pentacles", viName: "Tám Xu", file: "Pentacles08.png", element: "Đất", meaning: "Tỉ mỉ trau dồi tay nghề, chăm chỉ tập trung, rèn luyện kỹ năng bậc thầy", revMeaning: "Lười biếng thiếu tập trung, làm ẩu đoảng, cảm giác công việc tẻ nhạt" },
    { id: "P09", name: "Nine of Pentacles", viName: "Chín Xu", file: "Pentacles09.png", element: "Đất", meaning: "Độc lập tự chủ tài chính, hưởng thụ thành quả tao nhã, tự tin kiêu hãnh", revMeaning: "Phụ thuộc kinh tế, tiêu xài hoang phí che đậy sự trống rỗng" },
    { id: "P10", name: "Ten of Pentacles", viName: "Mười Xu", file: "Pentacles10.png", element: "Đất", meaning: "Thịnh vượng lâu dài, cơ nghiệp gia đình, di sản truyền thừa vững bền", revMeaning: "Tranh chấp tài sản gia đình, rủi ro tài chính lớn, đổ vỡ cơ nghiệp" },
    { id: "P11", name: "Page of Pentacles", viName: "Bồi Xu", file: "Pentacles11.png", element: "Đất", meaning: "Ham học hỏi thực tế, cơ hội học việc mới, tư duy quản lý tài chính", revMeaning: "Lười nhác, thiếu thực tế, bỏ lỡ kế hoạch học tập/công việc" },
    { id: "P12", name: "Knight of Pentacles", viName: "Kỵ sĩ Xu", file: "Pentacles12.png", element: "Đất", meaning: "Kiên trì bền bỉ, cần mẫn đáng tin, làm việc chu toàn từng bước", revMeaning: "Cứng nhắc bảo thủ, chậm chạp ì ạch, quá cứng nhắc không chịu đổi mới" },
    { id: "P13", name: "Queen of Pentacles", viName: "Hậu Xu", file: "Pentacles13.png", element: "Đất", meaning: "Ấm áp thực tế, tài năng quản lý gia đình và tài chính, chu toàn thực tế", revMeaning: "Lo âu vật chất quá độ, bỏ bê sức khỏe, chi ly tính toán" },
    { id: "P14", name: "King of Pentacles", viName: "Vua Xu", file: "Pentacles14.png", element: "Đất", meaning: "Vương giả tài chính, doanh nhân quyền lực, chỗ dựa kinh tế vững chắc", revMeaning: "Tham lam vật chất, độc đoán trong tiền bạc, đầu tư rủi ro mù quáng" },

    // 14 Lá Bộ Kiếm (Swords - Khí - Tư duy & Thử thách)
    { id: "S01", name: "Ace of Swords", viName: "Át Kiếm", file: "Swords01.png", element: "Khí", meaning: "Trí tuệ sáng suốt, nhát kiếm sự thật, đột phá tư duy tỏ tường", revMeaning: "Tư duy bế tắc, lời nói cay độc sát thương, ngộ nhận sai lầm" },
    { id: "S02", name: "Two of Swords", viName: "Hai Kiếm", file: "Swords02.png", element: "Khí", meaning: "Lưỡng lự ngã ba đường, bịt mắt né tránh sự thật, bế tắc lựa chọn", revMeaning: "Mở mắt nhìn thẳng sự thật, buộc phải ra quyết định, thông tin rõ ràng" },
    { id: "S03", name: "Three of Swords", viName: "Ba Kiếm", file: "Swords03.png", element: "Khí", meaning: "Vết cắt tổn thương, nỗi đau tan vỡ, sự thật mất lòng đau đớn", revMeaning: "Vết thương bắt đầu lành, buông bỏ oán hận, vượt qua nỗi đau" },
    { id: "S04", name: "Four of Swords", viName: "Bốn Kiếm", file: "Swords04.png", element: "Khí", meaning: "Tĩnh dưỡng hồi sức, tạm dừng nghỉ ngơi, thiền định sau cuộc chiến", revMeaning: "Kiệt sức vì không chịu nghỉ ngơi, căng thẳng bùng nổ trở lại" },
