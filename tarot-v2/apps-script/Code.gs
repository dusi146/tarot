    var last = sheet.getLastRow(), list = [];
    if (last >= 2) sheet.getRange(2, 1, Math.min(last - 1, 10), 2).getValues().forEach(function (row) {
      if (row[0] && row[1]) list.push({ name: row[0], amount: row[1] });
